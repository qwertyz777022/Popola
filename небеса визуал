local tabs = {}
local function mkTab(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -10, 0, 32)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    b.BackgroundTransparency = 0.4
    b.Text = name
    b.TextColor3 = Color3.fromRGB(180, 180, 190)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.Parent = sb
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local f = Instance.new("ScrollingFrame")
    f.Size = UDim2.new(1, -10, 1, -10)
    f.Position = UDim2.new(0, 5, 0, 5)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ScrollBarThickness = 3
    f.Visible = false
    f.Parent = ca

    local ly = Instance.new("UIListLayout")
    ly.Padding = UDim.new(0, 5)
    ly.Parent = f

    local function upd()
        f.CanvasSize = UDim2.new(0, 0, 0, ly.AbsoluteContentSize.Y + 10)
    end
    ly:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd)
    f.ChildAdded:Connect(function() wait(0.05) upd() end)

    tabs[name] = {b = b, f = f, u = upd}

    b.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.b.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            t.b.TextColor3 = Color3.fromRGB(180, 180, 190)
            t.f.Visible = false
        end
        b.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        f.Visible = true
        wait(0.05) upd()
    end)
    return f, b
end

