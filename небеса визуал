-- ФУНКЦИЯ ЧЕРНЫХ ПАЛЕТОК (ТОЛЬКО СВОИ)
local palletsEnabled = false
local savedPallets = {}

local function makePalletBlack(part)
    if not savedPallets[part] then
        savedPallets[part] = {Color = part.Color, Material = part.Material}
    end
    part.Color = Color3.fromRGB(0, 0, 0)
    part.Material = Enum.Material.SmoothPlastic
end

local function togglePallets(state)
    palletsEnabled = state
    if not state then
        for part, data in pairs(savedPallets) do
            if part and part.Parent then
                part.Color = data.Color
                part.Material = data.Material
            end
        end
        savedPallets = {}
    end
end

-- Отслеживаем только те объекты, которые спавнятся рядом с нами
w.DescendantAdded:Connect(function(obj)
    if palletsEnabled and obj:IsA("BasePart") then
        -- 1. Игнорируем закрепленные объекты (это карта)
        if obj.Anchored then return end
        -- 2. Игнорируем части персонажей
        local parent = obj.Parent
        if parent and (parent:FindFirstChildOfClass("Humanoid") or parent:IsA("Accessory")) then return end
        -- 3. Игнорируем большие объекты
        if obj.Size.Magnitude > 100 then return end

        -- 4. Проверяем расстояние до игрока (чтобы красить ТОЛЬКО свои спавны)
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and (obj.Position - hrp.Position).Magnitude < 50 then
            spawn(function()
                wait(0.1) -- Ждем полной прогрузки палетки
                if obj and obj.Parent and palletsEnabled then
                    makePalletBlack(obj)
                end
            end)
        end
    end
end)

-- Вода
local sw = {}
local function mdW(a, c)
    local t = w:FindFirstChildOfClass("Terrain")
    if t then
        if a == "remove" then t.WaterTransparency = 1; t.WaterWaveSize = 0
        elseif a == "restore" then t.WaterTransparency = 0.3; t.WaterWaveSize = 0.15
        elseif a == "color" then t.WaterColor = c; t.WaterTransparency = 0.3 end
    end
    spawn(function()
        for _, o in ipairs(w:GetDescendants()) do
            if o:IsA("BasePart") and o ~= t then
                local n = string.lower(o.Name)
                if o.Material == Enum.Material.Water or string.find(n, "water") or string.find(n, "ocean") then
                    if not sw[o] then sw[o] = {C = o.Color, T = o.Transparency} end
                    if a == "remove" then o.Transparency = 1
                    elseif a == "restore" then o.Transparency = sw[o].T or 0.5
                    elseif a == "color" then o.Color = c; o.Transparency = 0.5 end
                end
            end
        end
    end)
end

-- Оптимизация
local lb = {}
local function opt(s)
    if s then
        lb = {B = l.Brightness, A = l.Ambient, OA = l.OutdoorAmbient, F = l.FogEnd, GS = l.GlobalShadows, P = {}}
        l.Brightness = 3; l.Ambient = Color3.fromRGB(255, 255, 255); l.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        l.FogEnd = 1e9; l.GlobalShadows = false
        for _, e in ipairs(l:GetChildren()) do
            if e:IsA("PostEffect") then lb.P[e] = e.Enabled; e.Enabled = false end
        end
    else
        if lb.B then
            l.Brightness = lb.B; l.Ambient = lb.A; l.OutdoorAmbient = lb.OA; l.FogEnd = lb.F
            l.GlobalShadows = lb.GS
            for e, en in pairs(lb.P) do if e and e.Parent then e.Enabled = en end end
        end
    end
end

