local function addSld(p, t, mn, mx, df, c)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 46)
    f.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    f.BackgroundTransparency = 0.4
    f.Parent = p
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, -20, 0, 18)
    lb.Position = UDim2.new(0, 10, 0, 2)
    lb.BackgroundTransparency = 1
    lb.Text = t .. ": " .. tostring(df)
    lb.TextColor3 = Color3.fromRGB(230, 230, 235)
    lb.Font = Enum.Font.Gotham
    lb.TextSize = 12
    lb.TextXAlignment = Enum.TextXAlignment.Left
    lb.Parent = f
    local br = Instance.new("Frame")
    br.Size = UDim2.new(1, -20, 0, 6)
    br.Position = UDim2.new(0, 10, 0, 28)
    br.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
    br.Parent = f
    Instance.new("UICorner", br).CornerRadius = UDim.new(1, 0)
    local fl = Instance.new("Frame")
    fl.Size = UDim2.new((df - mn) / (mx - mn), 0, 1, 0)
    fl.BackgroundColor3 = Color3.fromRGB(80, 180, 120)
    fl.Parent = br
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)
    local kn = Instance.new("Frame")
    kn.Size = UDim2.new(0, 14, 0, 14)
    kn.Position = UDim2.new((df - mn) / (mx - mn), -7, 0.5, -7)
    kn.BackgroundColor3 = Color3.fromRGB(230, 230, 235)
    kn.Parent = br
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local dr = false
    local function up(inp)
        if br.AbsoluteSize.X <= 0 then return end
        local rlX = math.clamp(inp.Position.X - br.AbsolutePosition.X, 0, br.AbsoluteSize.X)
        local pc = rlX / br.AbsoluteSize.X
        local vl = math.floor(mn + (mx - mn) * pc)
        fl.Size = UDim2.new(pc, 0, 1, 0)
        kn.Position = UDim2.new(pc, -7, 0.5, -7)
        lb.Text = t .. ": " .. tostring(vl)
        spawn(function() pcall(function() c(vl) end) end)
    end
    br.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dr = true
            up(inp)
        end
    end)
    u.InputChanged:Connect(function(inp)
        if dr and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            up(inp)
        end
    end)
    u.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dr = false
        end
    end)
end

local function mkDrag(d, tg)
    local dr = false
    local sp, ds = nil, nil
    d.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dr = true
            ds = inp.Position
            sp = tg.Position
        end
    end)
    u.InputChanged:Connect(function(inp)
        if dr and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            local dl = inp.Position - ds
            tg.Position = UDim2.new(sp.X.Scale, sp.X.Offset + dl.X, sp.Y.Scale, sp.Y.Offset + dl.Y)
        end
    end)
    u.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dr = false
        end
    end)
end

