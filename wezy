local function ApplySkybox(skyName)
    local preset = SkyboxPresets[skyName]
    if not preset then return end
    local sky = Lighting:FindFirstChild("Nebesny_Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Name = "Nebesny_Sky"
        sky.Parent = Lighting
    end
    sky.SkyboxBk = preset.Bk
    sky.SkyboxDn = preset.Dn
    sky.SkyboxFt = preset.Ft
    sky.SkyboxLf = preset.Lf
    sky.SkyboxRt = preset.Rt
    sky.SkyboxUp = preset.Up
end

local function RestoreSkybox()
    local sky = Lighting:FindFirstChild("Nebesny_Sky")
    if sky then sky:Destroy() end
end

local ShaderObjects = {}
local function ApplyShader(presetName)
    local preset = ShaderPresets[presetName]
    if not preset then return end
    Lighting.Brightness = preset.Brightness
    Lighting.Ambient = preset.Ambient
    Lighting.OutdoorAmbient = preset.OutdoorAmbient
    Lighting.ClockTime = preset.ClockTime
    Lighting.FogEnd = preset.FogEnd
    Lighting.FogStart = preset.FogStart
    Lighting.ExposureCompensation = preset.ExposureCompensation
    if not ShaderObjects.CC then
        ShaderObjects.CC = Instance.new("ColorCorrectionEffect")
        ShaderObjects.CC.Name = "Nebesny_CC"
        ShaderObjects.CC.Parent = Lighting
    end
    ShaderObjects.CC.Brightness = preset.CC.Brightness
    ShaderObjects.CC.Contrast = preset.CC.Contrast
    ShaderObjects.CC.Saturation = preset.CC.Saturation
    ShaderObjects.CC.Tint = preset.CC.Tint
    if not ShaderObjects.Bloom then
        ShaderObjects.Bloom = Instance.new("BloomEffect")
        ShaderObjects.Bloom.Name = "Nebesny_Bloom"
        ShaderObjects.Bloom.Parent = Lighting
    end
    ShaderObjects.Bloom.Intensity = preset.Bloom.Intensity
    ShaderObjects.Bloom.Size = preset.Bloom.Size
    ShaderObjects.Bloom.Threshold = preset.Bloom.Threshold
end

