local function WaterAction(action, color)
    local t = Workspace:FindFirstChildOfClass("Terrain")
    if t then
        if action == "remove" then
            t.WaterTransparency = 1
            t.WaterWaveSize = 0
        elseif action == "restore" then
            t.WaterTransparency = 0.3
            t.WaterWaveSize = 0.15
        elseif action == "color" then
            t.WaterColor = color
            t.WaterTransparency = 0.3
        end
    end
    task.spawn(function()
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o:IsA("BasePart") and o ~= t then
                local n = string.lower(o.Name)
                if o.Material == Enum.Material.Water or string.find(n, "water") or string.find(n, "ocean") then
                    if action == "remove" then
                        o.Transparency = 1
                    elseif action == "restore" then
                        o.Transparency = 0.5
                    elseif action == "color" then
                        o.Color = color
                        o.Transparency = 0.5
                    end
                end
            end
        end
    end)
end

local BlackPalletsEnabled = false
local SavedPallets = {}

local function ToggleBlackPallets(state)
    BlackPalletsEnabled = state
    if not state then
        for part, data in pairs(SavedPallets) do
            if part and part.Parent then
                part.Color = data.Color
                part.Material = data.Material
            end
        end
        SavedPallets = {}
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if BlackPalletsEnabled and obj:IsA("BasePart") then
        if obj.Anchored then return end
        local parent = obj.Parent
        if parent and (parent:FindFirstChildOfClass("Humanoid") or parent:IsA("Accessory")) then return end
        if obj.Size.Magnitude > 100 then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and (obj.Position - hrp.Position).Magnitude < 50 then
            task.spawn(function()
                task.wait(0.1)
                if obj and obj.Parent and BlackPalletsEnabled then
                    if not SavedPallets[obj] then
                        SavedPallets[obj] = {Color = obj.Color, Material = obj.Material}
                    end
                    obj.Color = Color3.fromRGB(0, 0, 0)
                    obj.Material = Enum.Material.SmoothPlastic
                end
            end)
        end
    end
end)

