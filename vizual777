local function setSkybox(data)
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Name = "CustomSkybox"
        sky.Parent = Lighting
    end
    if type(data.id) == "table" then
        sky.SkyboxBk = "rbxassetid://" .. data.id[1]
        sky.SkyboxDn = "rbxassetid://" .. data.id[2]
        sky.SkyboxFt = "rbxassetid://" .. data.id[3]
        sky.SkyboxLf = "rbxassetid://" .. data.id[4]
        sky.SkyboxRt = "rbxassetid://" .. data.id[5]
        sky.SkyboxUp = "rbxassetid://" .. data.id[6]
    else
        local id = "rbxassetid://" .. tostring(data.id)
        sky.SkyboxBk = id
        sky.SkyboxDn = id
        sky.SkyboxFt = id
        sky.SkyboxLf = id
        sky.SkyboxRt = id
        sky.SkyboxUp = id
    end
end

local function resetSkybox()
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky and sky.Name == "CustomSkybox" then sky:Destroy() end
end

