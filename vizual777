    end
end)

local blackObjectsState = false
local objectBackup = {}

local function makeObjectBlack(obj)
    if obj:IsA("BasePart") then
        if not objectBackup[obj] then objectBackup[obj] = {Color = obj.Color} end
        obj.Color = Color3.new(0, 0, 0)
    elseif obj:IsA("Texture") or obj:IsA("Decal") then
        if not objectBackup[obj] then objectBackup[obj] = {Color3 = obj.Color3} end
        obj.Color3 = Color3.new(0, 0, 0)
    end
end

local function applyBlackObjects(state)
    blackObjectsState = state
    if state then
        task.spawn(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Texture") or obj:IsA("Decal") then
                    makeObjectBlack(obj)
                end
            end
        end)
    else
        for obj, data in pairs(objectBackup) do
            if obj and obj.Parent then
                if obj:IsA("BasePart") and data.Color then obj.Color = data.Color end
                if (obj:IsA("Texture") or obj:IsA("Decal")) and data.Color3 then obj.Color3 = data.Color3 end
            end
        end
        objectBackup = {}
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if blackObjectsState then
        if obj:IsA("BasePart") or obj:IsA("Texture") or obj:IsA("Decal") then
            makeObjectBlack(obj)
        end
    end
end)

local optimizationBackup = {}
local function applyOptimization(state)
    if state then
        optimizationBackup.Lighting = {
            GlobalShadows = Lighting.GlobalShadows,
            Brightness = Lighting.Brightness,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
            FogEnd = Lighting.FogEnd,
        }
        optimizationBackup.PostEffects = {}
        optimizationBackup.Parts = {}

        Lighting.GlobalShadows = false
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.FogEnd = 1e9

        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") then
                optimizationBackup.PostEffects[v] = v.Enabled
                v.Enabled = false
            end
        end

        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            optimizationBackup.Terrain = {
                WaveSize = terrain.WaterWaveSize,
                WaveSpeed = terrain.WaterWaveSpeed,
                Reflectance = terrain.WaterReflectance,
                Transparency = terrain.WaterTransparency,
            }
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end

        task.spawn(function()
            local count = 0
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    optimizationBackup.Parts[obj] = {
                        Material = obj.Material,
                        Reflectance = obj.Reflectance,
                        CastShadow = obj.CastShadow,
                    }
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                    obj.CastShadow = false
                    count = count + 1
                    if count % 100 == 0 then task.wait() end
                end
            end
        end)
    else
        local lb = optimizationBackup.Lighting
        if lb then
            Lighting.GlobalShadows = lb.GlobalShadows
            Lighting.Brightness = lb.Brightness
            Lighting.EnvironmentDiffuseScale = lb.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = lb.EnvironmentSpecularScale
            Lighting.FogEnd = lb.FogEnd
        end
        for obj, enabled in pairs(optimizationBackup.PostEffects or {}) do
            if obj and obj.Parent then obj.Enabled = enabled end
        end
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        local tb = optimizationBackup.Terrain
        if tb and terrain then
            terrain.WaterWaveSize = tb.WaveSize
            terrain.WaterWaveSpeed = tb.WaveSpeed
            terrain.WaterReflectance = tb.Reflectance
            terrain.WaterTransparency = tb.Transparency
        end
        for obj, data in pairs(optimizationBackup.Parts or {}) do
            if obj and obj.Parent then
                obj.Material = data.Material
                obj.Reflectance = data.Reflectance
                obj.CastShadow = data.CastShadow
            end
        end
        optimizationBackup = {}
    end
end

